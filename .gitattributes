# Every text file is LF in the index and LF in every working tree, whatever a clone's
# core.autocrlf says. Three things depend on it and none of them would say so when it
# broke: the workflows run `git diff --exit-code` to prove the emit idempotent, so a CRLF
# checkout reports the generator out of step; check:docs measures a document in characters,
# and a CR is one; and every reader of a generated file splits on '\n' and keeps the CR, so
# a comparison that should match differs by an invisible byte. check:generated holds the
# other half, refusing a tracked text file that carries a CR at all.
* text=auto eol=lf

# A binary is diffed by nothing and converted by nothing. Each is named ahead of the first
# one committed, because the cost of the omission is a corrupted file and the cost of the
# line is a line. The wrapper jar is the one this tree carries today.
*.jar       binary
*.aar       binary
*.keystore  binary
*.jks       binary
*.p12       binary
*.tgz       binary
*.zip       binary
*.car       binary
*.ttf       binary
*.otf       binary
*.woff2     binary
*.png       binary
*.ico       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.pdf       binary

# An .svg is XML and a .pbxproj is a property list: both are read and reviewed as text, and
# get LF like the rest. Naming them is what keeps text=auto from having to guess.
*.svg       text eol=lf
*.pbxproj   text eol=lf

# The wrapper is a shell script git has to keep executable, and a CRLF here is the failure
# mode where the shebang line carries a CR and the kernel reports the interpreter missing.
gradlew     text eol=lf
gradlew.bat text eol=crlf
